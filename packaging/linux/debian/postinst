#!/bin/sh
# best-effort refresh of the desktop and icon caches after install/upgrade
set -e
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q /usr/share/icons/hicolor >/dev/null 2>&1 || true
fi
if command -v update-icon-cache >/dev/null 2>&1; then
    update-icon-cache -q /usr/share/icons/hicolor >/dev/null 2>&1 || true
fi
# refresh the font cache so fontconfig sees the bundled fonts right away
# (best effort: fc-cache lives in the fontconfig package, which the .deb
# does not require; fontconfig also rebuilds its cache lazily)
if command -v fc-cache >/dev/null 2>&1; then
    fc-cache -f /usr/share/fonts >/dev/null 2>&1 || true
fi
